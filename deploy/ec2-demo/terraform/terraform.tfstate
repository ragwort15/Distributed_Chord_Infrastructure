      "type": "string"
    },
    "demo_checklist": {
      "value": "\n============================================================\n  CHORD DHT DEMO IS DEPLOYING\n============================================================\n  Wait ~3 minutes for EC2 bootstrap to finish, then:\n\n  1. Ring health:\n     curl http://54.213.239.144:5001/chord/ping\n\n  2. Submit a job:\n     curl -X POST http://54.213.239.144:5001/jobs \\\n       -H \"Content-Type: application/json\" \\\n       -d '{\"type\":\"echo\",\"payload\":{\"message\":\"hello chord\"}}'\n\n  3. View Grafana:\n     http://54.213.239.144:3000  (admin/admin)\n\n  4. SSH into instance:\n     ssh -i deploy/ec2-demo/chord-demo-key.pem ec2-user@54.213.239.144\n\n============================================================\n",
      "type": "string"
    },
    "grafana_url": {
      "value": "http://54.213.239.144:3000",
      "type": "string"
    },
    "instance_id": {
      "value": "i-03c03be5aa4a25f3e",
      "type": "string"
    },
    "instance_public_ip": {
      "value": "54.213.239.144",
      "type": "string"
    },
    "prometheus_url": {
      "value": "http://54.213.239.144:9090",
      "type": "string"
    },
    "ssh_command": {
      "value": "ssh -i deploy/ec2-demo/chord-demo-key.pem ec2-user@54.213.239.144",
      "type": "string"
    }
  },
