# =============================================================================
# Dockerfile.demo — lightweight image for EC2 demo
# Uses Python 3.11 (stable LTS). Skips heavy dev deps (pytest, anthropic).
# =============================================================================

# Stage 1: Builder
FROM python:3.11-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

# Install only runtime deps (skip pytest, anthropic for demo)
# --prefix=/install places packages under /install/lib/python3.11/site-packages/
# which we COPY to /usr/local in the runtime stage — always on sys.path regardless of user
RUN pip install --no-cache-dir --prefix=/install \
    flask \
    waitress \
    requests \
    prometheus-client \
    grpcio \
    grpcio-tools

# Stage 2: Runtime
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Packages land at /usr/local/lib/python3.11/site-packages/ — found by any user
COPY --from=builder /install /usr/local

# Copy application source
COPY chord/      ./chord/
COPY storage/    ./storage/
COPY api/        ./api/
COPY run_node.py .
COPY submit_job.py .
COPY entrypoint.sh .

RUN chmod +x entrypoint.sh

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN useradd -m -u 1000 chord && chown -R chord:chord /app
USER chord

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
    CMD curl -sf http://localhost:${CHORD_PORT:-5000}/chord/ping || exit 1

EXPOSE 5000

ENTRYPOINT ["sh", "entrypoint.sh"]
