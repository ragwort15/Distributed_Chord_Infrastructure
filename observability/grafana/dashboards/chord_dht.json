{
  "title": "Chord DHT — Live Observability",
  "uid": "chord-dht-01",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-5m", "to": "now" },
  "timezone": "browser",
  "tags": ["chord", "dht", "distributed"],
  "panels": [
    {
      "id": 1,
      "title": "Workers (live / idle / busy / dead)",
      "description": "Live worker pool composition over time. busy = workers with at least one PENDING task assigned to them.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "short"
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(chord_workers_live)", "legendFormat": "live", "refId": "A" },
        { "expr": "sum(chord_workers_idle)", "legendFormat": "idle", "refId": "B" },
        { "expr": "sum(chord_workers_busy)", "legendFormat": "busy", "refId": "C" },
        { "expr": "sum(chord_workers_dead)", "legendFormat": "dead", "refId": "D" }
      ]
    },
    {
      "id": 4,
      "title": "Pending Tasks",
      "description": "HT1 records currently in PENDING state across the ring.",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "#f59e0b", "mode": "fixed" },
          "unit": "short"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        { "expr": "sum(chord_tasks_pending)", "legendFormat": "pending", "refId": "A" }
      ]
    },
    {
      "id": 7,
      "title": "Stabilizations / sec",
      "type": "stat",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "#d29922", "mode": "fixed" },
          "unit": "ops",
          "decimals": 2
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        { "expr": "sum(rate(chord_stabilize_runs_total[1m]))", "legendFormat": "stab/s", "refId": "A" }
      ]
    },
    {
      "id": 8,
      "title": "Hop Count Distribution (O(log N) proof)",
      "description": "Distribution of routing hops. With N nodes the Chord guarantee is O(log N) ≈ log₂(N) hops maximum.",
      "type": "bargauge",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "options": { "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] }, "displayMode": "gradient" },
      "targets": [
        { "expr": "sum(chord_file_request_hops_bucket{le='1.0'})", "legendFormat": "1 hop",  "refId": "A" },
        { "expr": "sum(chord_file_request_hops_bucket{le='2.0'}) - sum(chord_file_request_hops_bucket{le='1.0'})", "legendFormat": "2 hops", "refId": "B" },
        { "expr": "sum(chord_file_request_hops_bucket{le='3.0'}) - sum(chord_file_request_hops_bucket{le='2.0'})", "legendFormat": "3 hops", "refId": "C" },
        { "expr": "sum(chord_file_request_hops_bucket{le='+Inf'}) - sum(chord_file_request_hops_bucket{le='3.0'})", "legendFormat": "4+ hops", "refId": "D" }
      ]
    },
    {
      "id": 9,
      "title": "Queue Depth per Node",
      "description": "Active jobs in each node's local store. Flat = good load balance (AI placement working).",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15 },
          "unit": "short",
          "min": 0
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "chord_queue_depth", "legendFormat": "Node {{node_id}}", "refId": "A" }
      ]
    },
    {
      "id": 10,
      "title": "Task Latency (p50 / p95 / p99)",
      "description": "End-to-end file request latency percentiles. p95 spike after fault injection shows recovery overhead.",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "s"
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(chord_task_duration_seconds_bucket[2m])) by (le))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(chord_task_duration_seconds_bucket[2m])) by (le))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(chord_task_duration_seconds_bucket[2m])) by (le))", "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "id": 11,
      "title": "Data Keys per Node",
      "description": "Number of keys stored locally on each node. Even distribution = consistent hashing working correctly.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "short",
          "min": 0
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "chord_data_keys_total", "legendFormat": "Node {{node_id}}", "refId": "A" }
      ]
    },
    {
      "id": 13,
      "title": "Recent Tasks — Submit / Complete / Duration",
      "description": "Per-task timeline aggregated ring-wide via /api/dht/contents (HT1 result:* records). Submitted = created_at, Completed = updated_at (== finish time once status is SUCCESS/FAILURE). Duration computed server-side.",
      "type": "table",
      "gridPos": { "x": 0, "y": 23, "w": 24, "h": 10 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity-chord" },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "http://host.docker.internal:5005/api/dht/contents",
          "url_options": { "method": "GET", "data": "" },
          "root_selector": "ht1",
          "columns": [
            { "selector": "task_id",    "text": "Task ID",     "type": "string" },
            { "selector": "task_type",  "text": "Type",        "type": "string" },
            { "selector": "status",     "text": "Status",      "type": "string" },
            { "selector": "worker_id",  "text": "Worker",      "type": "string" },
            { "selector": "created_at", "text": "Submitted",   "type": "number" },
            { "selector": "updated_at", "text": "Completed",   "type": "number" },
            { "selector": "duration_s", "text": "Duration (s)","type": "number" }
          ]
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Task ID": 0,
              "Type": 1,
              "Status": 2,
              "Worker": 3,
              "Submitted": 4,
              "Completed": 5,
              "Duration (s)": 6
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Submitted" },
            "properties": [
              { "id": "unit", "value": "dateTimeAsIso" },
              { "id": "custom.width", "value": 180 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Completed" },
            "properties": [
              { "id": "unit", "value": "dateTimeAsIso" },
              { "id": "custom.width", "value": 180 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Duration (s)" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "decimals", "value": 2 },
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background", "mode": "gradient" }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green",  "value": null },
                    { "color": "yellow", "value": 5 },
                    { "color": "red",    "value": 15 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "SUCCESS": { "color": "green",  "index": 0, "text": "SUCCESS" } } },
                  { "type": "value", "options": { "RUNNING": { "color": "blue",   "index": 1, "text": "RUNNING" } } },
                  { "type": "value", "options": { "PENDING": { "color": "orange", "index": 2, "text": "PENDING" } } },
                  { "type": "value", "options": { "FAILURE": { "color": "red",    "index": 3, "text": "FAILURE" } } }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-text" }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": { "show": false },
        "sortBy": [{ "displayName": "Submitted", "desc": true }]
      }
    },
    {
      "id": 12,
      "title": "Predecessor Failures Detected",
      "description": "Times a node detected its predecessor died. Spikes correspond to fault injection events.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "#f85149", "mode": "fixed" },
          "custom": { "lineWidth": 2 },
          "unit": "short"
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "sum(rate(chord_predecessor_failures_total[1m])) by (node_id)", "legendFormat": "Node {{node_id}}", "refId": "A" }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "hide": 2
      }
    ]
  }
}
